# =============================================================================
# Сервис «Снег-Диспетчер» — шаблон переменных окружения (.env.example)
# Скопируйте в .env и заполните реальные значения. НЕ коммитьте .env в Git!
# Спецификация: docs/01_commercial_proposal_and_tz.md (раздел B13)
# =============================================================================

# --- Приложение ---
APP_ENV=development                                  # development | staging | production
APP_DEBUG=true                                       # В production строго false
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000                # В production: https://sneg.example.ru
TIMEZONE=Europe/Moscow
SECRET_KEY=change-me-to-64-char-random-hex
LOG_LEVEL=INFO                                       # DEBUG | INFO | WARNING | ERROR

# Веб-симулятор MAX-бота (строго false в production!)
ENABLE_SIMULATOR=true

# --- MAX Bot API (актуально на 11.2026: platform-api2.max.ru) ---
MESSENGER_TRANSPORT=simulator                        # max | simulator
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=replace-with-max-bot-token             # Передаётся в заголовке Authorization
MAX_UPDATE_MODE=webhook                              # webhook (prod) | polling (dev)
MAX_WEBHOOK_SECRET=replace-with-random-secret-32ch   # Проверка заголовка X-Max-Bot-Api-Secret
MAX_CA_BUNDLE_PATH=/etc/ssl/certs/ca-certificates.crt # Должен включать сертификаты Минцифры РФ
MAX_GLOBAL_RPS=25                                    # Глобальный лимит MAX — 30 RPS
MAX_PER_CHAT_RPS=2                                   # Лимит MAX на 1 чат — 2 req/s
MAX_DISPATCH_CHAT_ID=                                # Заполняется после события bot_added / привязки в админке

# --- База данных (PostgreSQL 16) и Redis 7 / ARQ ---
DATABASE_URL=postgresql+asyncpg://sneg:sneg@postgres:5432/sneg
REDIS_URL=redis://redis:6379/0
FSM_TTL_SECONDS=21600                                # 6 часов

# --- Платёжный провайдер (PaymentProvider) ---
PAYMENT_PROVIDER=mock                                # yookassa | mock (mock запрещён в production)
YOOKASSA_SHOP_ID=replace-with-shop-id
YOOKASSA_SECRET_KEY=replace-with-secret-key
YOOKASSA_FORCE_SBP=true                              # true -> payment_method_data.type = "sbp" (capture=true)
YOOKASSA_TAX_SYSTEM_CODE=2                           # 2 = УСН доходы (уточнить с бухгалтером)
YOOKASSA_VAT_CODE=1                                  # 1 = без НДС (уточнить с бухгалтером)
YOOKASSA_TRUSTED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11/32,77.75.156.35/32,77.75.154.128/25,2a02:5180::/32

# --- Хранилище фотоотчётов (FileStorage, серверы в РФ) ---
STORAGE_PROVIDER=local                               # s3 | local
LOCAL_STORAGE_DIR=./var/media
S3_ENDPOINT_URL=https://storage.yandexcloud.net      # В dev: http://minio:9000
S3_BUCKET=sneg-media
S3_REGION=ru-central1
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_PRESIGNED_TTL_SECONDS=900

# --- Прогноз погоды для подписок (WeatherProvider, Этап 3) ---
WEATHER_PROVIDER=mock                                # open_meteo | mock
WEATHER_API_KEY=

# --- Веб-админ-панель и юридические ссылки ---
ADMIN_JWT_SECRET=change-me-to-another-64-char-hex
ADMIN_JWT_TTL_MINUTES=480
INITIAL_OWNER_EMAIL=owner@example.ru
INITIAL_OWNER_PASSWORD=change-me-strong-password
PUBLIC_OFFER_URL=https://chistodvor.ru/legal/offer
PRIVACY_POLICY_URL=https://chistodvor.ru/legal/privacy
EXECUTOR_OFFER_URL=https://chistodvor.ru/legal/executor-offer

# --- Юридические реквизиты оператора (отображаются на /legal/* и в футере) ---
BRAND_NAME=ЧистоДвор
LEGAL_OPERATOR_NAME=ИП Холматов Леонид Икрамович
LEGAL_INN=                                           # 12 цифр ИНН ИП (заполнить до приёма оплат)
LEGAL_OGRNIP=                                        # 15 цифр ОГРНИП (заполнить до приёма оплат)
LEGAL_ADDRESS=Российская Федерация, Московская область
LEGAL_EMAIL=privacy@chistodvor.ru
LEGAL_PHONE=                                         # Контактный телефон оператора
LEGAL_RKN_REG_NO=                                    # Рег. номер из реестра операторов ПДн РКН
LEGAL_DATACENTER_INFO=ЦОД на территории Российской Федерации (ООО «Таймвэб.Клауд», РФ)
LEGAL_DOC_VERSION=2.0
LEGAL_DOC_UPDATED_DATE=17.11.2026

# --- Наблюдаемость и алерты ---
SENTRY_DSN=
ALERTS_MAX_CHAT_ID=
